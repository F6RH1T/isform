{
  "name": "enorpa-is-formlari",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ENORPA İş Formları — servis formları, firma kartları, bakım takibi ve AI asistanı (PWA)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "test": "node --test",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.2",
    "vite": "^5.4.11"
  }
}
