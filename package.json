{
  "name": "enorpa-is-formlari",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "ENORPA İş Formları — servis formları, firma kartları, bakım takibi ve AI asistanı (PWA)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "test": "node --test tests/unit/*.test.js",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project enorpa-kural-testi 'node --test tests/rules/*.test.js'"
  },
  "dependencies": {
    "firebase": "12.14.0",
    "heic2any": "0.0.4",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.0",
    "prettier": "^3.4.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
